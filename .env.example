# Frontend endpoint for the contact form
VITE_API_URL=/api/integrations
VITE_FORM_SOURCE=landing_it_beauty

# Integration backend credentials (set these in Vercel dashboard or local .env)
# Example: YCLIENTS/WaHelp or amoCRM details depending on your setup
INTEGRATION_DOMAIN=your-integration-domain.example
AMO_DOMAIN=your-account.amocrm.ru
AMO_CLIENT_ID=your_client_id
AMO_CLIENT_SECRET=your_client_secret
AMO_REFRESH_TOKEN=your_refresh_token
INTEGRATION_PIPELINE_ID=your_pipeline_id
INTEGRATION_TAG=Сайт IT BEAUTY
